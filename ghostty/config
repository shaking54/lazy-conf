# Light theme with a white background
# Previous dark theme (revert by swapping the lines): theme = Kanagawa Dragon
theme = Builtin Light
background = ffffff

# Remove the empty border/padding around terminal content so nvim fills the window
window-padding-x = 0
window-padding-y = 0

# Don't add extra padding when the cell grid doesn't divide evenly
window-padding-balance = true
